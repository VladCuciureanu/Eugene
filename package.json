{
  "name": "@eugene/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.2"
  },
  "bin": {
    "eugene": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test \"test/**/*_test.ts\"",
    "typecheck": "tsc",
    "lint": "biome lint .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
